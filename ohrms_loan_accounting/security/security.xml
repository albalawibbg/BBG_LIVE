<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 19 security groups use privilege_id on res.groups.
             The privilege links to the loan category created by ohrms_loan. -->
        <record model="res.groups.privilege" id="privilege_loan_reschedule">
            <field name="name">Loan Reschedule</field>
            <field name="category_id" ref="ohrms_loan.module_category_employee_loan_extra_rights"/>
            <field name="sequence">50</field>
        </record>

        <record id="group_loan_reschedule" model="res.groups">
            <field name="name">Reschedule</field>
            <field name="privilege_id" ref="privilege_loan_reschedule"/>
        </record>

    </data>
</odoo>
