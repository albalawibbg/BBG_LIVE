<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Periodic garbage collection of MCP sessions and queued messages.
        See models/mcp_session.py — _gc() closes idle sessions, deletes old closed
        sessions and their messages, and removes delivered messages past the
        retention window.
    -->
    <record id="ir_cron_mcp_session_gc" model="ir.cron">
        <field name="name">RAG Odoo MCP Server: GC sessions and messages</field>
        <field name="model_id" ref="model_rag_odoo_mcp_server_mcp_session"/>
        <field name="state">code</field>
        <field name="code">model._gc()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
