              id="menu_hr_loan_all_request" name="All requests" parent="menu_hr_loans_and_advances" sequence="40"/>
    <!-- Shortcuts -->
    <record id="act_hr_employee_loan_request" model="ir.actions.act_window">
        <field name="name">Loans</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.loan</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id', '=', active_id)]</field>
        <field name="context">{'search_default_myloan': 1}</field>
        <field name="view_id" ref="hr_loan_tree_view"/>
    </record>
    <!-- HR employee inherit Loans -->
    <record id="view_employee_form_loan_inherit" model="ir.ui.view">
        <field name="name">hr.employee.loan.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" groups="hr.group_hr_manager,hr.group_hr_user" icon="fa-calendar"
                        name="%(act_hr_employee_loan_request)d" type="action">
                    <field name="loan_count" string="Loans" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
