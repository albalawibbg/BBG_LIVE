<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Loan Tree view-->
    <record id="hr_loan_tree_view" model="ir.ui.view">
        <field name="name">hr.loan.tree</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Loan Requests">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="balance_amount"/>
                <field name="loan_amount"/>
                <field name="date"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--Loan Form view-->
    <record id="hr_loan_form_view" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Loan Request">
                <header>
                    <button class="oe_highlight" groups="ohrms_loan.group_loan_submit"
                            invisible="state not in ['draft']" name="action_submit" string="Submit" type="object"/>
                    <button class="oe_highlight" groups="ohrms_loan.group_loan_approbation_1"
                            invisible="state not in ['waiting_approval_1']" name="action_approve_1"
                            string="First Approve" type="object"/>
                    <button class="oe_highlight" groups="ohrms_loan.group_loan_approbation_2"
                            invisible="state not in ['approve1']" name="action_approve" string="Second Approve"
                            type="object"/>
                    <button class="oe_highlight" groups="hr.group_hr_manager"
                            invisible="state not in ['draft','waiting_approval_1','approve1']" name="action_refuse"
                            string="Refuse" type="object"/>
                    <button invisible="state not in ['draft']" name="action_cancel" string="Cancel" type="object"/>
                    <field name="state" statusbar_visible="draft,waiting_approval_1,approve1,approve"
                           widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-list" name="action_view_loans" type="object">
                            <field name="global_remaining_amount" string="" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-pencil" name="open_entries" type="object">
                            <field name="loan_journal_count" string="Journal Entries" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group col="4">
                        <field name="employee_id" readonly="state != 'draft'"/>
                        <field name="date" readonly="state != 'draft'"/>
                        <field name="department_id"/>
                        <field name="job_position"/>
                        <field name="loan_amount" readonly="state not in ('draft', 'waiting_approval_1')"/>
                        <field name="installment" readonly="state not in ('draft', 'waiting_approval_1')"/>
                        <field name="payment_date" readonly="state not in ('draft', 'waiting_approval_1')"/>
                        <field groups="base.group_multi_company" name="company_id" options="{'no_create': True}"/>
                        <field groups="base.group_multi_company" name="currency_id" options="{'no_create': True}"
                               readonly="state != 'draft'"/>
                        <field name="multi_loan" readonly="state not in ('draft', 'waiting_approval_1')"
                               string="Allow Multi Loan"/>
                        <field invisible="1" name="user_id"/>
                    </group>
                    <notebook>
                        <page readonly="state not in ('draft', 'waiting_approval_1')" string="Installments">
                            <field name="loan_lines">
                                <list editable="bottom" string="Installments">
                                    <field invisible="1" name="advance_pay_group"/>
                                    <field name="date" readonly="paid == True"/>
                                    <field name="amount" readonly="paid == True"/>
                                    <field name="paid" readonly="advance_pay_group == False"/>
                                </list>
                                <form string="Installments">
                                    <field invisible="1" name="advance_pay_group"/>
                                    <field name="date" readonly="paid == True"/>
                                    <field name="amount" readonly="paid == True"/>
                                    <field name="paid" readonly="advance_pay_group == False"/>
                                </form>
                            </field>
                            <button class="oe_highlight" invisible="state in ('approve', 'refuse')"
                                    name="compute_installment" string="Loan Installment" type="object"/>
                            <group class="oe_subtotal_footer oe_right" colspan="2">
                                <field name="total_amount" options="{'currency_field': 'currency_id'}"/>
                                <field name="total_paid_amount" options="{'currency_field': 'currency_id'}"/>
                                <field class="oe_subtotal_footer_separator" name="balance_amount"
                                       options="{'currency_field': 'currency_id'}"/>
                                <separator/>
                                <field class="oe_subtotal_footer_separator" invisible="1" name="global_balance_amount"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page invisible="state != 'refuse'" string="Refusal Details">
                            <group>
                                <field name="refuse_reason" readonly="1"/>
                                <field name="date_refuse" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--loan search view-->
    <record id="view_loan_request_search_form" model="ir.ui.view">
        <field name="name">hr.loan.search.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <search string="Loan">
                <filter domain="[('employee_id.user_id.id', '=', uid)]" name="myrequest" string="My Requests"/>
                <field name="employee_id" string="Employee"/>
                <field name="department_id" string="Department"/>
                <filter context="{'group_by':'employee_id'}" name="employee_id" string="Employee"/>
                <filter context="{'group_by':'department_id'}" name="department_id" string="Department"/>
                <filter context="{'group_by':'state'}" name="status" string="Status"/>
            </search>
        </field>
    </record>
    <!--loan menu-->
    <menuitem id="menu_hr_loans_and_advances" name="Loans" parent="hr.menu_hr_root" sequence="20"/>
    <record id="action_hr_loan_request" model="ir.actions.act_window">
        <field name="name">Request for Loan</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_myrequest': 1}</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Loan request.
            </p>
            <p>
                Use this menu to create loan requests.
            </p>
        </field>
    </record>
    <record id="action_hr_loan_my_request" model="ir.actions.act_window">
        <field name="name">My Loan request</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <!--        <field name="context">{'search_default_myrequest': 1}</field>-->
        <field name="domain">[('employee_id.user_id.id', '=', uid)]</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Loan request.
            </p>
            <p>
                Use this menu to create loan requests.
            </p>
        </field>
    </record>
    <record id="action_hr_loan_to_approve_request" model="ir.actions.act_window">
        <field name="name">To approve Loan request</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('waiting_approval_1','approve1'))]</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Loan request.
            </p>
            <p>
                Use this menu to create loan requests.
            </p>
        </field>
    </record>
    <record id="action_hr_loan_approved_request" model="ir.actions.act_window">
        <field name="name">Approved Loan request</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'approve')]</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Loan request.
            </p>
            <p>
                Use this menu to create loan requests.
            </p>
        </field>
    </record>
    <record id="action_hr_loan_all_request" model="ir.actions.act_window">
        <field name="name">All Loan request</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Loan request.
            </p>
            <p>
                Use this menu to create loan requests.
            </p>
        </field>
    </record>
