<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_collections" model="ir.ui.view">
        <field name="name">sale.order.form.hakbani.collections</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="hakbani_invoiced_amount" readonly="1" groups="sales_team.group_sale_salesman_all_leads"/>
                <field name="hakbani_collected_amount" readonly="1" groups="sales_team.group_sale_salesman_all_leads"/>
                <field name="hakbani_outstanding_amount" readonly="1" groups="sales_team.group_sale_salesman_all_leads"/>
            </xpath>
        </field>
    </record>
    <record id="view_order_tree_collections" model="ir.ui.view">
        <field name="name">sale.order.tree.hakbani.collections</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="hakbani_collected_amount" optional="show" groups="sales_team.group_sale_salesman_all_leads"/>
                <field name="hakbani_outstanding_amount" optional="show" groups="sales_team.group_sale_salesman_all_leads"/>
            </xpath>
        </field>
    </record>
    <record id="view_quotation_tree_collections" model="ir.ui.view">
        <field name="name">sale.quotation.tree.hakbani.collections</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="after">
                <field name="hakbani_collected_amount" optional="show" groups="sales_team.group_sale_salesman_all_leads"/>
                <field name="hakbani_outstanding_amount" optional="show" groups="sales_team.group_sale_salesman_all_leads"/>
            </xpath>
        </field>
    </record>
</odoo>
