<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Put fields in search AND explicit Group By area. The Many2one fields
         intentionally are not numeric measures. -->
    <record id="sale_report_search_manager_inherit" model="ir.ui.view">
        <field name="name">sale.report.search.sales.manager.hakbani</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="team_id" string="Sales Team"/>
                <field name="team_leader_id" string="Sales Leader"/>
                <group expand="1" string="Team &amp; Leader Group By">
                    <filter name="group_by_hakbani_sales_team" string="Sales Team"
                            context="{'group_by': 'team_id'}"/>
                    <filter name="group_by_hakbani_sales_manager" string="Sales Leader"
                            context="{'group_by': 'team_leader_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Shows leader down the left and team across the top on a fresh pivot.
         Existing user-saved pivot favourites still override default layout. -->
    <record id="sale_report_pivot_team_leader_inherit" model="ir.ui.view">
        <field name="name">sale.report.pivot.sales.team.leader.hakbani</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="team_leader_id" type="row" string="Sales Leader"/>
                <field name="team_id" type="col" string="Sales Team"/>
                <field name="team_sales_amount" type="measure" string="Sales Team Sales Amount"/>
                <field name="leader_sales_amount" type="measure" string="Sales Leader Sales Amount"/>
            </xpath>
        </field>
    </record>
</odoo>
